<?xml version="1.0" encoding="utf-8"?>
<!-- MainWindow.xaml — the whole window, in DiscWright's own
     palette from line one (the Mac Step 2 + 2.5 lesson): the
     indigo SonicStage backdrop with two lavender/navy panes,
     as the web app's Create a CD lays them out — library on
     the left; on the right the disc stage over the
     blank/capacity controls and the action row (Burn Disc
     BESIDE Import ISO, per the user's explicit layout
     requirement); the log across the bottom. The window is a
     real Windows window — only the colors and the stage are
     hers. Bindings are classic {Binding} against the store
     (RootGrid.DataContext, set in code-behind). -->
<Window
    x:Class="DiscWright.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="DiscWright — ATRAC3+ CD ISO maker">

    <Grid x:Name="RootGrid" Background="{StaticResource ClientGradientBrush}" Padding="12">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" ItemsPath="Tracks"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== header band: wordmark on the SonicStage purple ===== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                BorderBrush="{StaticResource DeepBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- the web titlebar's app-icon: a silver disc
                     with the #123a82 hub (radial stand-in for
                     the Mac glyph's conic ring) -->
                <Grid Width="30" Height="30" VerticalAlignment="Center">
                    <Ellipse Stroke="#73000000" StrokeThickness="1">
                        <Ellipse.Fill>
                            <media:RadialGradientBrush>
                                <GradientStop Color="#FFF0F7FF" Offset="0"/>
                                <GradientStop Color="#FFDCECFF" Offset="0.55"/>
                                <GradientStop Color="#FF8DB6E8" Offset="0.82"/>
                                <GradientStop Color="#FFDCECFF" Offset="1"/>
                            </media:RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource GlyphHubBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DiscWright" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="ATRAC3+ CD ISO maker" Foreground="{StaticResource SubtitleOnBlueBrush}" FontSize="13"/>
                </StackPanel>
                <!-- the web's one visible mode tab, as a pill -->
                <Border Grid.Column="2" Background="{StaticResource ModePillGradientBrush}"
                        BorderBrush="{StaticResource DeepBorderBrush}" BorderThickness="2"
                        CornerRadius="14" Padding="18,6" VerticalAlignment="Center">
                    <TextBlock Text="Create a CD" Foreground="{StaticResource ModePillTextBrush}"
                               FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== panes ===== -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <!-- soft ribbon bands across the indigo — a quiet
                 echo of the ribbon wallpapers the web window
                 floats over (the Mac backdrop does the same) -->
            <Border Background="#12FFFFFF" CornerRadius="90" Height="130"
                    VerticalAlignment="Top" Margin="-60,-50,-160,0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-16"/>
                </Border.RenderTransform>
            </Border>
            <Border Background="#21C2C9F4" CornerRadius="110" Height="170"
                    VerticalAlignment="Top" Margin="60,150,-120,0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-16"/>
                </Border.RenderTransform>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="412"/>
                </Grid.ColumnDefinitions>

                <!-- ===== My Library (left) ===== -->
                <Border Grid.Column="0" Background="{ThemeResource PaneBrush}"
                        BorderBrush="{StaticResource DeepBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="My Library" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{ThemeResource PaneTextBrush}"/>
                            <TextBlock Text="{Binding LibInfoText}" FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                            <Button Content="Add Files…" Click="AddFiles_Click" IsEnabled="{Binding IntakeEnabled}"/>
                            <Button Content="Add Folder…" Click="AddFolder_Click" IsEnabled="{Binding IntakeEnabled}"/>
                            <Button Content="Add Group" Click="AddGroup_Click" IsEnabled="{Binding IntakeEnabled}"/>
                        </StackPanel>
                        <ListView x:Name="TrackList" Grid.Row="2"
                                  ItemsSource="{Binding Source={StaticResource GroupsSource}}"
                                  SelectionMode="None"
                                  CanReorderItems="True" CanDragItems="True" AllowDrop="True">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderContainerStyle>
                                        <Style TargetType="ListViewHeaderItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </GroupStyle.HeaderContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardHeaderGradientBrush}"
                                                    BorderBrush="{ThemeResource CardHeaderBorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="6,4" Margin="0,6,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Group:" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource CardHeaderTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding Editable}" Width="280"
                                                             HorizontalAlignment="Left" Margin="8,0"/>
                                                    <Button Grid.Column="2" Content="Remove group" Click="RemoveGroup_Click"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{ThemeResource RowBackgroundBrush}"
                                          BorderBrush="{ThemeResource RowSeparatorBrush}"
                                          BorderThickness="0,0,0,1" Padding="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Title" IsEnabled="{Binding Editable}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Artist" IsEnabled="{Binding Editable}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Album" IsEnabled="{Binding Editable}"/>
                                        <Grid Grid.Column="3" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource BadBrush}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding DurationText}" FontFamily="Consolas"
                                                       Foreground="{ThemeResource DurTextBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0"
                                                    Visibility="{Binding Imported, Converter={StaticResource InvBoolToVis}}">
                                            <Button Content="↑" Click="MoveUp_Click" ToolTipService.ToolTip="Move up"/>
                                            <Button Content="↓" Click="MoveDown_Click" ToolTipService.ToolTip="Move down"/>
                                            <Button Content="Move" Click="MoveToGroup_Click" ToolTipService.ToolTip="Move to another group"/>
                                            <Button Content="✕" Click="RemoveTrack_Click" ToolTipService.ToolTip="Remove track"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- ===== ATRAC CD (right) ===== -->
                <Border Grid.Column="1" Margin="12,0,0,0" Background="{ThemeResource PaneBrush}"
                        BorderBrush="{StaticResource DeepBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="ATRAC CD" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{ThemeResource PaneTextBrush}"/>
                            <TextBlock Text="Drive: ISO image" FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- the disc stage (Win2D). Height 416
                             (v39): the painted artwork — disc
                             plus its ground shadow — spans about
                             2.5x the disc's radius, which never
                             fit ANY earlier stage height (440,
                             336, 384 all clipped the bottom).
                             The painter now caps the radius at
                             160 and centers the whole span in
                             this stage, with clear air above the
                             status line below. The window stays
                             at v37's 980; the buttons keep their
                             room. -->
                        <canvas:CanvasControl x:Name="DiscCanvas" Grid.Row="1" Height="416"
                                              ClearColor="Transparent"
                                              Draw="DiscCanvas_Draw"/>
                        <TextBlock Grid.Row="2" Text="{Binding StageStatus}"
                                   Foreground="{ThemeResource StageStatusBrush}"
                                   FontWeight="Bold" FontSize="13" Margin="0,6,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"/>

                        <Rectangle Grid.Row="3" Height="1" Margin="0,8"
                                   Fill="{ThemeResource RowSeparatorBrush}"/>

                        <!-- blank picker (the web's order + Custom…) -->
                        <!-- IsEnabled lives on the ComboBox/TextBox below,
                             NOT on this StackPanel: in WinUI, IsEnabled exists
                             only on Control, and putting it on the panel made
                             the XAML compiler die silently (bisect v15,
                             2026-11-06). Do not put it back. -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Blank:" VerticalAlignment="Center"
                                       Foreground="{ThemeResource PaneTextBrush}"/>
                            <ComboBox x:Name="BlankCombo" Width="200"
                                      IsEnabled="{Binding IntakeEnabled}"
                                      SelectionChanged="BlankCombo_SelectionChanged"/>
                            <TextBox x:Name="CustomBlankBox" Width="84"
                                     IsEnabled="{Binding IntakeEnabled}"
                                     Text="{Binding CustomBlankText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="CustomBlankLabel" Text="sectors" Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- capacity: her indigo meter, red only when over -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MeterTrack" Height="14" VerticalAlignment="Center"
                                    Background="{ThemeResource MeterTrackBrush}"
                                    BorderBrush="{StaticResource MeterBorderBrush}" BorderThickness="1"
                                    SizeChanged="MeterTrack_SizeChanged">
                                <Border x:Name="MeterFill" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource MeterFillBrush}"/>
                            </Border>
                            <TextBlock x:Name="CapacityTextBlock" Grid.Column="1"
                                       Text="{Binding CapacityText}" FontSize="13"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- actions: Burn Disc BESIDE Import ISO -->
                        <StackPanel Grid.Row="6" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="BurnButton" Content="Burn Disc" Click="BurnDisc_Click"
                                        IsEnabled="{Binding BurnEnabled}"
                                        Background="{StaticResource SsBlue2Brush}" Foreground="White"
                                        FontSize="16" FontWeight="Bold" Padding="18,8"/>
                                <Button Content="Import ISO…" Click="ImportIso_Click"
                                        FontSize="16" Padding="14,8"/>
                                <Button Content="✕ Clear imported disc" Click="ClearImport_Click"
                                        Visibility="{Binding HasImported, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Final version (v32): Burn Disc runs
                                 the whole job now — encode, author,
                                 and the burn offer in one go (the
                                 encode's ISO still lands in
                                 Downloads). This row keeps the
                                 encode's Cancel and the workers
                                 picker. The Make ISO button that
                                 lived here was Lola's temporary
                                 encoder test path (v26–v31) and is
                                 removed in the final version at her
                                 word. Every IsEnabled below sits on
                                 the Control itself, NEVER on a panel
                                 (see the blank-picker note above).
                                 Workers bounds/value are set in
                                 code-behind (they depend on the
                                 machine's core count). -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button Content="Cancel" Click="CancelEncode_Click"
                                        IsEnabled="{Binding IsEncoding}"
                                        FontSize="14" Padding="14,7"
                                        VerticalAlignment="Center"/>
                                <!-- The workers selector is a ComboBox,
                                     NOT a NumberBox: the NumberBox killed
                                     startup outright on Lola's machine
                                     (0xc000027b in Microsoft.UI.Xaml.dll;
                                     bisected v30a/v30b, 2026-11-06 - the
                                     build WITHOUT it launched, the one
                                     WITH it died). Do not reintroduce it.
                                     A ComboBox of 1..cores does the same
                                     job and matches the blank picker. -->
                                <TextBlock Text="Encode workers" VerticalAlignment="Center"/>
                                <ComboBox x:Name="WorkersCombo" MinWidth="76"
                                          SelectionChanged="WorkersCombo_SelectionChanged"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Burn Disc encodes a new disc, authors its ISO to Downloads, then offers the burn."
                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{ThemeResource SmallTextBrush}"
                                       Visibility="{Binding HasImported, Converter={StaticResource InvBoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== log ===== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Height="110"
                Background="{ThemeResource LogBackgroundBrush}"
                BorderBrush="{StaticResource LogBorderBrush}" BorderThickness="1" CornerRadius="2">
            <ListView x:Name="LogList" ItemsSource="{Binding LogLines}" SelectionMode="None" Padding="6">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource LogTextBrush}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>
